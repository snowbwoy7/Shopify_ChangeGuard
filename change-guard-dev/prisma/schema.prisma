// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Operation {
  id               String    @id
  shop             String
  status           String    @default("draft")
  operationType    String
  inputJson        String
  planJson         String?
  planHash         String
  approvalTokenHash String?
  approvedAt       DateTime?
  approvalExpiresAt DateTime?
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  executedAt       DateTime?

  @@index([shop, createdAt])
  @@index([shop, status])
  @@index([planHash])
}

model OperationEvent {
  id          String   @id
  operationId String
  shop        String
  eventType   String
  metadataJson String?
  createdAt   DateTime @default(now())

  @@index([operationId, createdAt])
  @@index([shop, createdAt])
}
